#compdef brick
# zsh completion for brick
# Place this file at:
#   ~/.local/share/zsh/site-functions/_brick

_brick() {
    local -a args
    args=(
        '(--login)'--login'[Log in via browser]'
        '(--switch-accounts)'--switch-accounts'[Switch the active account]'
        '(--whoami)'--whoami'[Show logged-in user and account details]'
        '(--restart)'--restart'[Clear existing settings and configure Brick from scratch]'
        '(-d --daemon)'{-d,--daemon}'[Detach into the background once logged in and reachable]'
        '(-r --remote-control)'{-r,--remote-control}'[Allow the Storage API to remotely list/browse/transfer files on this device]'
        '(--agent-root)'--agent-root'[Additional directory to expose to remote clients when remote control is enabled]:directory:_files -/'
        '(-s --selective-sync)'{-s,--selective-sync}'[Choose which folders to exclude from sync]'
        '(--list-selective-sync)'--list-selective-sync'[List the folders currently excluded from sync]'
        '(--no-upgrade-check)'--no-upgrade-check'[Disable automatic upgrade check]'
        '(--no-control-api)'--no-control-api'[Disable the local status/control API]'
        '(--uninstall)'--uninstall'[Uninstall brick]'
        '(-h --help)'{-h,--help}'[Show help information]'
        '(-v --version)'{-v,--version}'[Show version information]'
    )
    _arguments -s $args
}

_brick "$@"
